{
  "name": "auth-dance",
  "version": "0.1.0",
  "description": "Coordinated authentication recovery for Node.js, CLI and oRPC",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UnitedSuperintelligence/auth-dance.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "import": "./dist/orpc.js"
    }
  },
  "bin": {
    "auth-dance": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@orpc/server": "^1.14.13",
    "axios": "^1.12.0",
    "proper-lockfile": "4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.0"
  },
  "private": true
}
